# ── AI API ─────────────────────────────────────────────────────────────────────
# OpenAI-compatible endpoint (OpenAI / Azure / local Ollama / vLLM)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o

# ── Evaluation Thresholds ─────────────────────────────────────────────────────
# Scores are 0-1; higher = stricter pass bar
HALLUCINATION_THRESHOLD=0.5
RELEVANCY_THRESHOLD=0.7
FAITHFULNESS_THRESHOLD=0.7
ANSWER_CORRECTNESS_THRESHOLD=0.7

# LLM-as-judge: score out of 10 that a response must achieve
LLM_JUDGE_THRESHOLD=7

# Cosine similarity for semantic-equivalence assertions (0-1)
SEMANTIC_SIMILARITY_THRESHOLD=0.82

# Context window utilisation % at which hallucination risk warnings fire
CONTEXT_UTILIZATION_WARNING_PCT=70
CONTEXT_UTILIZATION_CRITICAL_PCT=85

# ── Performance SLOs ──────────────────────────────────────────────────────────
P95_LATENCY_THRESHOLD_MS=5000
P99_LATENCY_THRESHOLD_MS=10000
MIN_TOKENS_PER_SECOND=10
CONCURRENT_USERS=5

# ── Retry ─────────────────────────────────────────────────────────────────────
AI_RETRY_ATTEMPTS=3

# ── UI / Playwright ───────────────────────────────────────────────────────────
UI_BASE_URL=https://app.clickup.com
CHAT_PATH=/ai-chat            # path to the AI chat feature within the app
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=30000

# ── Reports ───────────────────────────────────────────────────────────────────
REPORTS_DIR=reports
